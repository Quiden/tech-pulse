{
  "name": "tech-pulse",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "Mikhail Kachalkov",
  "main": "index.js",
  "scripts": {
    "prestart": "pnpm i18next:interface",
    "start": "webpack serve --env port=3005",
    "build:prod": "webpack -c ./webpack.config.ts --env mode=production",
    "build:dev": "webpack -c ./webpack.config.ts --env mode=development",
    "pretypecheck": "pnpm i18next:interface",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "stylelint": "npx stylelint \"**/*.css\"",
    "stylelint:fix": "npx stylelint \"**/*.css\" --fix",
    "routes:generate": "tsr generate",
    "routes:watch": "tsr watch",
    "i18next:interface": "i18next-resources-for-ts interface -i public/locales/en -o src/common/config/i18n/resources.d.ts"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-router-devtools": "^1.167.0",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11"
  },
  "devDependencies": {
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.2",
    "@svgr/webpack": "^8.1.0",
    "@swc/core": "^1.16.1",
    "@tanstack/router-cli": "^1.167.25",
    "@tanstack/router-plugin": "^1.168.23",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "css-loader": "^7.1.4",
    "esbuild": "^0.28.1",
    "esbuild-loader": "^4.5.0",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.6.8",
    "i18next-resources-for-ts": "^2.1.0",
    "lint-staged": "^17.3.0",
    "mini-css-extract-plugin": "^2.10.2",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "react-refresh": "^0.18.0",
    "style-loader": "^4.0.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "swc-loader": "^0.2.7",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "webpack": "^5.109.0",
    "webpack-cli": "^7.2.1",
    "webpack-dev-server": "^6.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{json,css,md,html,yml,yaml}": "oxfmt"
  }
}
