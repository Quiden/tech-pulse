    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "css-loader": "^7.1.4",
    "esbuild": "^0.28.1",
    "esbuild-loader": "^4.5.0",
    "html-webpack-plugin": "^5.6.8",
    "lint-staged": "^17.3.0",
    "mini-css-extract-plugin": "^2.10.2",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "style-loader": "^4.0.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "webpack": "^5.109.0",
